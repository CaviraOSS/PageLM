{
	"name": "pagelm",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"setup": "npm install --omit=dev",
		"build": "tsc",
		"start": "node ./dist/app.js",
		"serve": "npm run build && nodemon ./dist/app.js",
		"views:dev": "vite dev",
		"views:build": "vite build",
		"dev": "concurrently \"nodemon ./src/app.ts\" \"vite dev\"",
		"devx": "concurrently \"tsc --watch\" \"nodemon --watch dist ./dist/app.js\" \"vite dev\""
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@types/node": "^22.20.5",
		"@types/ws": "^8.18.1",
		"concurrently": "^9.1.2",
		"svelte": "^5.56.1",
		"tailwindcss": "^4.3.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3",
		"vite": "^8.0.16"
	}
}
