{
	"name": "pagelm",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"setup": "npm install --omit=dev",
		"start": "node ./src/app.js",
		"dev": "nodemon ./src/app.js & vite dev",
		"lines": "node src/scripts/lines.js",
		"serve": "nodemon ./src/app.js",
		"views:dev": "vite dev",
		"views:build": "vite build",
		"views:watch": "vite build --watch",
		"views:preview": "vite preview",
		"views:prepare": "svelte-kit sync || echo ''",
		"views:check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"views:check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"svelte": "^5.56.1",
		"tailwindcss": "^4.3.0",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"ws": "^8.22.1"
	}
}